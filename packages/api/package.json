{
  "name": "@analytics/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute analytics --file=migrations/0000_init.sql --remote",
    "db:migrate": "wrangler d1 migrations apply analytics --remote",
    "check": "tsc --noEmit",
    "lint": "biome lint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@analytics/shared": "workspace:*",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "ua-parser-js": "^2.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "4.86.0"
  }
}
